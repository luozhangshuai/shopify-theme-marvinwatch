{%- doc -%}
  Renders the featured image for a menu item.

  @param {object} link - The link to render
  @param {string} [class] - The class to apply to the image
  @param {string} [sizes] - The sizes to apply to the image
  @param {string} [loading] - The loading strategy to apply to the image

  @example
  {% render 'menu-featured-image', link: link %}
{%- enddoc -%}

{% liquid
  assign image_sizes = sizes | default: 'auto'
  assign image_loading = loading | default: 'lazy'
  assign menu_image = blank

  if link.object != blank
    assign menu_image = link.object.metafields.custom.menu_image.value
  endif
%}

{% if menu_image != blank %}
  {{
    menu_image
    | image_url: width: 800
    | image_tag: loading: image_loading, class: class, sizes: image_sizes
  }}
{% elsif link.type == 'collection_link' %}
  {% if link.object.featured_image %}
    {{
      link.object.featured_image
      | image_url: width: 800
      | image_tag: loading: image_loading, class: class, sizes: image_sizes
    }}
  {% comment %} {% elsif link.object.products.size > 0 %}
    {% assign product_object = link.object.products | where: 'featured_image' | first %}
    {% if product_object.featured_image %}
      {{
        product_object.featured_image
        | image_url: width: 800
        | image_tag: loading: image_loading, class: class, sizes: image_sizes
      }}
    {% endif %} {% endcomment %}
  {% endif %}
{% elsif link.type == 'collections_link' %}
  {% assign collection_object = collections | where: 'featured_image' | first %}
  {% if collection_object.featured_image %}
    {{
      collection_object.featured_image
      | image_url: width: 800
      | image_tag: loading: image_loading, class: class, sizes: image_sizes
    }}
  {% endif %}
{% elsif link.type == 'catalog_link' %}
  {% comment %} {% assign product_object = collections.all.products | where: 'featured_image' | first %}
  {{
    product_object.featured_image
    | image_url: width: 800
    | image_tag: loading: image_loading, class: class, sizes: image_sizes
  }} {% endcomment %}
{% elsif link.type == 'article_link' %}
  {% if link.object.image %}
    {{
      link.object.image
      | image_url: width: 800
      | image_tag: loading: image_loading, class: class, sizes: image_sizes
    }}
  {% endif %}
{% endif %}
