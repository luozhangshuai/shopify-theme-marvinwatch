{%- doc -%}
Renders mega menu list markup and optional featured content.

@param {object} parent_link - The linklist to render.
@param {string} id - Unique ID to assign to the `ul` element.
@param {number} [grid_columns_count] - Number of grid columns for the mega menu.
@param {number} [grid_columns_count_tablet] - Number of grid columns for the mega menu on tablets.
@param {number} [grid_columns_count_collection_images] - Number of grid columns when `menu_content_type` is
'collection_images'.
@param {string} [menu_content_type] - Type of content: 'featured_products', 'featured_collections',
'collection_images', or 'text'.
@param {number} [content_aspect_ratio] - Aspect ratio for content images.
@param {number} [image_border_radius] - Border radius for content images.
@param {object} [section] - The section object.
@param {boolean} [marvin-set] - 桌面端菜单导航，默认不启用

@example
{% render 'mega-menu-list', parent_link: link, id: 'MegaMenuList-1', grid_columns_count: 6, menu_content_type: 'featured_products' %}
{%- enddoc -%}

{% liquid
  render 'vite-tag', entry: 'mega-menu-list.css'
  render 'vite-tag', entry: 'mega-menu-list.ts'

  comment
    open_column_span tracks when a vertical column in the mega menu is open.
    Links will be stacked in the column until the code closes the column span.
  endcomment
  assign open_column_span = false
  assign column_count = 0
  assign links_before_wrap = 10
  assign max_menu_columns = grid_columns_count | default: 6
  assign max_menu_columns_tablet = grid_columns_count_tablet | default: 4

  ##
  # We only eager load heavy elements of the page when rendering this template
  # through the Section Rendering API.
  #
  # This keeps the initial render lightweight, minimizing the impact on TTFB.
  # The second render then refreshes the page with additional content.
  #
  # At the moment, we check if the Section Rendering API is being used by
  # checking if section.index is blank.
  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif

  if menu_content_type == 'collection_images'
    assign collection_links = parent_link.links | where: 'type', 'collection_link'
    assign catalog_links = parent_link.links | where: 'type', 'catalog_link'
    assign collection_list_links = parent_link.links | where: 'type', 'collections_link'
    if collection_links.size == 0 and catalog_links.size == 0 and collection_list_links.size == 0
      assign menu_content_type = 'text'
    endif
  endif

  if menu_content_type == 'featured_collections'
    if parent_link.type == 'collection_link'
      assign collection_handles = parent_link.object.handle | append: ','
    elsif parent_link.type == 'catalog_link' or parent_link.type == 'collections_link'
      assign collection_handles = 'all' | append: ','
    endif
    assign collection_links = parent_link.links | where: 'type', 'collection_link'
    for collection_link in collection_links
      assign collection_handles = collection_handles | append: collection_link.object.handle | append: ','
    endfor
  endif

  if menu_content_type == 'featured_products'
    if parent_link.type == 'collection_link'
      assign collection_object = parent_link.object
    elsif parent_link.type == 'catalog_link' or parent_link.type == 'collections_link'
      assign collection_object = collections.all
    else
      assign menu_content_type = 'text'
    endif
  endif

  assign marvin_has_category_links = false
  assign marvin_has_top_level_products = false
  assign marvin_has_leaf_links = false
  assign marvin_default_panel_index = 0

  if marvin-set == true
    for link in parent_link.links
      if link.links != blank
        assign marvin_has_category_links = true
        if marvin_default_panel_index == 0
          assign marvin_default_panel_index = forloop.index
        endif
      elsif link.type == 'product_link'
        assign marvin_has_top_level_products = true
      else
        assign marvin_has_leaf_links = true
      endif
    endfor
  endif
%}
<ul data-menu-list-id="{{ id }}"
    class="mega-menu__list list-unstyled{% if marvin-set == true %} mega-menu__list--marvin{% if marvin_has_category_links %} mega-menu__list--marvin-shell{% elsif marvin_has_top_level_products and marvin_has_leaf_links == false %} mega-menu__list--marvin-products-only{% endif %}{% endif %}"
    {% if marvin-set == true and marvin_has_category_links %}data-marvin-shell{% endif %}
    style="--menu-image-border-radius: {{ image_border_radius }}px;
        --marvin-products-columns: 6;
        --marvin-card-aspect-ratio: 5 / 3;
        grid-template-columns: repeat({{ block.settings.menu_products_limit_column }}, 1fr);
        justify-items: center;">
  {% if marvin-set == true %}
    {% if marvin_has_category_links %}
      <li class="mega-menu__marvin-sidebar">
        <ul class="mega-menu__marvin-categories list-unstyled">
          {% for link in parent_link.links %}
            {% unless link.type == 'product_link' and link.links == blank %}
              {%- capture marvin_featured_image -%}
                {% render 'link-featured-image', link: link, class: 'mega-menu__marvin-image', sizes: '72px' %}
              {%- endcapture -%}
              <li class="mega-menu__marvin-category-item{% if link.links != blank %} mega-menu__marvin-category-item--has-panel{% endif %}{% if forloop.index == marvin_default_panel_index %} is-default{% endif %}"
                  {% if link.links != blank %}data-marvin-panel="{{ forloop.index }}"{% endif %}>
                <a href="{{ link.url }}"
                   class="mega-menu__marvin-trigger mega-menu__link{% if link.links != blank %} mega-menu__link--parent{% endif %}"
                   {% if link.links != blank %}data-marvin-panel="{{ forloop.index }}"{% endif %}>
                  {% if marvin_featured_image != blank %}
                    <span class="mega-menu__marvin-image-link">
                      {{ marvin_featured_image }}
                    </span>
                  {% endif %}
                  <span class="mega-menu__marvin-title">
                    <span class="wrap-text">{{ link.title }}</span>
                  </span>
                </a>
              </li>
            {% endunless %}
          {% endfor %}
        </ul>
      </li>
      <li class="mega-menu__marvin-panels">
        {% for link in parent_link.links %}
          {% if link.links != blank %}
            <div class="mega-menu__marvin-panel{% if forloop.index == marvin_default_panel_index %} is-default{% endif %}"
                 data-marvin-panel="{{ forloop.index }}">
              <div class="mega-menu__marvin-panel-header">
                <a href="{{ link.url }}" class="mega-menu__marvin-panel-title mega-menu__link mega-menu__link--parent">
                  <span class="wrap-text">{{ link.title }}</span>
                </a>
              </div>
              <ul class="mega-menu__marvin-products list-unstyled">
                {% for childlink in link.links limit: 6 %}
                  <li class="mega-menu__marvin-product-item{% unless childlink.type == 'product_link' and childlink.object != blank %} mega-menu__marvin-product-item--link{% endunless %}">
                    {% if childlink.type == 'product_link' and childlink.object != blank %}
                      {% render 'resource-card', resource: childlink.object, resource_type: 'product', price_v: false, image_aspect_ratio: '5 / 3', featured_image_override: childlink.object.metafields.custom.menu_image.value, show_menu_small_text: true %}
                    {% else %}
                      {%- capture marvin_child_featured_image -%}
                        {% render 'link-featured-image', link: childlink, class: 'mega-menu__marvin-child-image', sizes: '(min-width: 990px) 180px, 30vw' %}
                      {%- endcapture -%}
                      <a href="{{ childlink.url }}" class="mega-menu__marvin-child-link mega-menu__link{% if marvin_child_featured_image != blank %} mega-menu__marvin-child-link--with-image{% endif %}">
                        {% if marvin_child_featured_image != blank %}
                          <span class="mega-menu__marvin-child-image-wrap">
                            {{ marvin_child_featured_image }}
                          </span>
                        {% endif %}
                        <span class="mega-menu__marvin-child-title wrap-text">{{ childlink.title }}</span>
                      </a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </li>
    {% elsif marvin_has_top_level_products and marvin_has_leaf_links == false %}
      {% for link in parent_link.links %}
        {% if link.type == 'product_link' %}
          <li class="mega-menu__menu-item mega-menu__marvin-product">
            {% render 'resource-card', resource: link.object, resource_type: 'product', price_v: false, image_aspect_ratio: '5 / 3', featured_image_override: link.object.metafields.custom.menu_image.value, show_menu_small_text: true %}
          </li>
        {% endif %}
      {% endfor %}
    {% else %}
      {% for link in parent_link.links %}
        {%- capture marvin_featured_image -%}
          {% render 'link-featured-image', link: link, class: 'mega-menu__marvin-image', sizes: '72px' %}
        {%- endcapture -%}
        <li class="mega-menu__marvin-category">
          <a href="{{ link.url }}" class="mega-menu__marvin-trigger mega-menu__link{% if link.links != blank %} mega-menu__link--parent{% endif %}">
            {% if marvin_featured_image != blank %}
              <span class="mega-menu__marvin-image-link">
                {{ marvin_featured_image }}
              </span>
            {% endif %}
            <span class="mega-menu__marvin-title">
              <span class="wrap-text">{{ link.title }}</span>
            </span>
          </a>
        </li>
      {% endfor %}
    {% endif %}
  {% else %}
    {% for link in parent_link.links %}
      {% liquid
        # Decide whether to open a column span, and how many columns of the grid to span
        if forloop.first or open_column_span == false
          assign open_column_span = true

          # Don't allow orphan links in a column
          assign break_after_modulo = link.links.size | modulo: links_before_wrap
          if break_after_modulo == 1
            assign links_before_wrap = links_before_wrap | minus: 1
          endif

          assign break_after_float = links_before_wrap | times: 1.0
          assign column_span = link.links.size | divided_by: break_after_float | ceil | at_least: 1
          assign column_count = column_count | plus: column_span
          assign should_break_columns = true
          assign span_class = ''

          if menu_content_type == 'collection_images'
            assign should_break_columns = false
            # For collection image mode, we have an 8-column grid when 4 or fewer parent links are used. Set column span to 2 in that case, otherwise use 1 column
            if parent_link.links.size <= 4
              assign span_class = 'mega-menu__column--wide-collection-image'
            endif
          else
            # For all other modes, column span is determined by the number of links in the parent link
            assign span_class = 'mega-menu__column--span-' | append: column_span
          endif
          echo '<li class="mega-menu__column ' | append: span_class | append: '">'
        endif %}
      <div>
        <a href="{{ link.url }}"
           class="mega-menu__link{%- if link.links != blank %} mega-menu__link--parent{%- endif -%}">
          {% if menu_content_type == 'collection_images' %}

            {%- capture collection_image_sizes -%}
              {%- if parent_link.links.size <= 4 -%}
                {%- assign columns_per_item = 2 -%}
              {%- else -%}
                {%- assign columns_per_item = 1 -%}
              {%- endif -%}
              {%- render 'util-mega-menu-img-sizes-attr', menu_content_type: 'collection_images', settings: settings, grid_columns: grid_columns_count, grid_columns_tablet: grid_columns_count_tablet, grid_columns_collection_images: grid_columns_count_collection_images, parent_links_size: parent_link.links.size, columns_per_item: columns_per_item -%}
            {%- endcapture -%}

            {% render 'link-featured-image', link: link, class: 'mega-menu__link-image', sizes: collection_image_sizes %}
          {% endif %}
          <span class="wrap-text">{{ link.title }}</span>
        </a>
        {% if link.links != blank %}
          <ul class="list-unstyled"
              {% if should_break_columns -%}style="column-count: {{ column_span }};"{%- endif -%}>
            {% for childLink in link.links %}
              {% assign break_after_modulo = forloop.index | modulo: links_before_wrap %}
              <li {% if break_after_modulo == 0 and should_break_columns -%}style="break-after: column;"{%- endif -%}>
                <a href="{{ childLink.url }}" class="mega-menu__link">
                  <span class="wrap-text">{{- childLink.title -}}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      {% liquid
        # Check conditions for closing the span at the end of each iteration, then close the span if needed
        assign next_linklist = parent_link.links[forloop.index]

        if forloop.last
          assign open_column_span = false
        elsif menu_content_type == 'collection_images'
          assign open_column_span = false
        elsif next_linklist.links != blank
          assign open_column_span = false
        elsif link.links != blank and next_linklist.links == blank
          assign open_column_span = false
        endif

        if open_column_span != false
          echo '</li>'
        endif %}
    {% endfor %}
  {% endif %}
</ul>

{% liquid
  # decide how many grid columns are needed for the menu list, and how many columns are needed for the featured content
  # prioritize a minimum of 1 featured_collection (2 columns), and minimum 2 featured_products (2 columns)
  assign min_products = 2
  assign max_products = 3
  assign min_products_tablet = 1
  assign max_products_tablet = 3
  assign min_collections = 1

  if menu_content_type == 'featured_products'
    # desktop breakpoint
    assign temp_column_count = column_count | plus: min_products

    if temp_column_count > max_menu_columns
      assign max_product_columns = 2
    else
      assign max_product_columns = max_menu_columns | minus: column_count | at_most: max_products
    endif

    if eager_loading
      assign max_product_columns = max_product_columns | at_most: collection_object.products_count
    else
      assign max_product_columns = 0
    endif

    assign max_featured_products = max_product_columns
    assign max_menu_columns = max_menu_columns | minus: max_product_columns

    # tablet breakpoint
    assign temp_column_count = column_count | plus: min_products_tablet

    if temp_column_count > max_menu_columns_tablet
      assign max_product_columns_tablet = 1
    else
      assign max_product_columns_tablet = max_menu_columns_tablet | minus: column_count | at_most: max_products_tablet
    endif

    assign max_product_columns_tablet = max_product_columns_tablet | at_most: max_product_columns

    assign max_featured_products_tablet = max_product_columns_tablet
    assign max_menu_columns_tablet = max_menu_columns_tablet | minus: max_product_columns_tablet
  endif

  if menu_content_type == 'featured_collections'
    # desktop breakpoint
    assign min_featured_collection_columns = min_collections | times: 2
    assign temp_column_count = column_count | plus: min_featured_collection_columns

    if temp_column_count > max_menu_columns
      assign max_collection_columns = 2
    else
      assign max_collection_columns = max_menu_columns | minus: column_count
    endif

    assign max_featured_collections = max_collection_columns | divided_by: 2 | floor
    assign max_menu_columns = max_menu_columns | minus: max_collection_columns

    # tablet breakpoint
    assign max_collection_columns_tablet = 2
    assign max_featured_collections_tablet = 1
    assign max_menu_columns_tablet = max_menu_columns_tablet | minus: max_collection_columns_tablet
  endif %}

{% style %}
  [data-menu-grid-id="{{ id }}"] {
  {% if menu_content_type == 'collection_images' and parent_link.links.size < 5 %}
    --menu-columns-desktop: {{ grid_columns_count_collection_images }};
    --menu-columns-tablet: {{ grid_columns_count_tablet }};
  {%- else -%}
    --menu-columns-desktop: {{ grid_columns_count }};
    --menu-columns-tablet: {{ grid_columns_count_tablet }};
  {%- endif %}
  }
  [data-menu-list-id="{{ id }}"] {
  {% if menu_content_type == 'collection_images' and parent_link.links.size < 5 %}
    --menu-columns-desktop: {{ grid_columns_count_collection_images }};
    --menu-columns-tablet: {{ max_menu_columns_tablet }};
  {%- else -%}
    --menu-columns-desktop: {{ max_menu_columns }};
    --menu-columns-tablet: {{ max_menu_columns_tablet }};
  {%- endif %}
  }

  .mega-menu__list--marvin {
    justify-items: stretch !important;
    align-items: start;
  }

  .mega-menu__list--marvin .mega-menu__marvin-category,
  .mega-menu__list--marvin .mega-menu__marvin-product,
  .mega-menu__list--marvin .mega-menu__marvin-sidebar,
  .mega-menu__list--marvin .mega-menu__marvin-panels {
    width: 100%;
    min-width: 0;
  }

  .mega-menu__list--marvin-shell {
    grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr) !important;
    gap: 2rem;
    justify-items: stretch !important;
  }

  .mega-menu__list--marvin-products-only {
    grid-template-columns: repeat(var(--marvin-products-columns, 6), minmax(0, 1fr)) !important;
    gap: 1.5rem;
  }

  .mega-menu__list--marvin-products-only .resource-card__media,
  .mega-menu__list--marvin-shell .mega-menu__marvin-product-item .resource-card__media {
    width: 100%;
    margin-inline: 0;
    overflow: hidden;
    border-radius: calc(var(--menu-image-border-radius) * 0.75);
  }

  .mega-menu__list--marvin .mega-menu__marvin-categories {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mega-menu__list--marvin .mega-menu__marvin-trigger,
  .mega-menu__list--marvin .mega-menu__marvin-trigger:hover {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 0.625rem 0.75rem;
    color: inherit;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mega-menu__list--marvin .mega-menu__marvin-category-item--has-panel > .mega-menu__marvin-trigger::after {
    content: '›';
    margin-left: auto;
    font-size: 1rem;
    line-height: 1;
  }

  .mega-menu__list--marvin .mega-menu__marvin-image-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .mega-menu__list--marvin .mega-menu__marvin-image {
    aspect-ratio: 1 / 1;
    width: 2rem;
    object-fit: cover;
    border-radius: calc(var(--menu-image-border-radius) * 0.75);
  }

  .mega-menu__list--marvin .mega-menu__marvin-title {
    display: block;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.35;
    text-decoration: none;
  }

  .mega-menu__list--marvin .mega-menu__marvin-category-item:hover .mega-menu__marvin-title,
  .mega-menu__list--marvin .mega-menu__marvin-category-item.is-active .mega-menu__marvin-title,
  .mega-menu__list--marvin .mega-menu__marvin-category-item:focus-within .mega-menu__marvin-title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .mega-menu__list--marvin .mega-menu__marvin-panels {
    position: relative;
    min-height: 100%;
  }

  .mega-menu__list--marvin .resource-card {
    row-gap: 0.875rem;
  }

  .mega-menu__list--marvin .resource-card__media {
    width: 100%;
  }

  .mega-menu__list--marvin .resource-card__image,
  .mega-menu__list--marvin .resource-card__image--secondary {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--menu-image-border-radius) * 0.75);
  }

  .mega-menu__list--marvin .resource-card__content {
    width: 100%;
  }

  .mega-menu__list--marvin .mega-menu__marvin-panel {
    display: none;
  }

  .mega-menu__list--marvin .mega-menu__marvin-panel.is-default {
    display: block;
  }

  .mega-menu__list--marvin-shell.has-active-panel .mega-menu__marvin-panel.is-default:not(.is-active) {
    display: none;
  }

  .mega-menu__list--marvin .mega-menu__marvin-panel.is-active {
    display: block;
  }

  .mega-menu__list--marvin .mega-menu__marvin-panel-title {
    display: inline-flex;
    padding: 0 0 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .mega-menu__list--marvin .mega-menu__marvin-products {
    display: grid;
    grid-template-columns: repeat(var(--marvin-products-columns, 4), minmax(0, 1fr));
    gap: 1.25rem;
  }

  .mega-menu__list--marvin .mega-menu__marvin-product-item {
    min-width: 0;
  }

  .mega-menu__list--marvin .mega-menu__marvin-product-item--link .mega-menu__marvin-child-link,
  .mega-menu__list--marvin .mega-menu__marvin-product-item--link .mega-menu__marvin-child-link:hover {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 0;
    color: inherit;
    text-decoration: none;
  }

  .mega-menu__list--marvin .mega-menu__marvin-child-image-wrap {
    display: block;
    width: 100%;
    aspect-ratio: var(--marvin-card-aspect-ratio);
    overflow: hidden;
    border-radius: calc(var(--menu-image-border-radius) * 0.75);
  }

  .mega-menu__list--marvin .mega-menu__marvin-child-image {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--marvin-card-aspect-ratio);
    object-fit: cover;
    border-radius: calc(var(--menu-image-border-radius) * 0.75);
  }

  .mega-menu__list--marvin .mega-menu__marvin-child-title {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .mega-menu__list--marvin .resource-card__title {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .mega-menu__list--marvin .resource-card__content,
  .mega-menu__list--marvin .resource-card__content .price,
  .mega-menu__list--marvin .resource-card__content .price * {
    font-size: 0.875rem;
    font-weight: 400;
  }

  .mega-menu__list--marvin .mega-menu__marvin-category .mega-menu__marvin-trigger,
  .mega-menu__list--marvin .mega-menu__marvin-category .mega-menu__marvin-trigger:hover {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    padding: 0;
    border-radius: 0;
    background: transparent;
  }

  .mega-menu__list--marvin .mega-menu__marvin-category .mega-menu__marvin-image-link {
    display: block;
    width: 66.6667%;
  }

  .mega-menu__list--marvin .mega-menu__marvin-category .mega-menu__marvin-image {
    display: block;
    width: 100%;
    aspect-ratio: var(--marvin-card-aspect-ratio);
    object-fit: cover;
    border-radius: calc(var(--menu-image-border-radius) * 0.75);
  }

  .mega-menu__list--marvin .mega-menu__marvin-category .mega-menu__marvin-title {
    font-size: 0.95rem;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    .mega-menu__list--marvin-shell,
    .mega-menu__list--marvin-products-only,
    .mega-menu__list--marvin .mega-menu__marvin-products {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .mega-menu__list--marvin-shell {
      gap: 1.25rem;
    }

    .mega-menu__list--marvin .mega-menu__marvin-sidebar,
    .mega-menu__list--marvin .mega-menu__marvin-panels {
      grid-column: 1 / -1;
    }

    .mega-menu__list--marvin .mega-menu__marvin-trigger,
    .mega-menu__list--marvin .mega-menu__marvin-trigger:hover {
      padding-inline: 0;
      border-radius: 0;
      background: transparent;
    }
  }
{% endstyle %}

{% if marvin-set == true and marvin_has_category_links %}
  <script>
    (() => {
      const menuShells = document.querySelectorAll('[data-marvin-shell]');

      menuShells.forEach((shell) => {
        const categoryItems = shell.querySelectorAll('.mega-menu__marvin-category-item[data-marvin-panel]');
        const panels = shell.querySelectorAll('.mega-menu__marvin-panel[data-marvin-panel]');

        if (!categoryItems.length || !panels.length) return;

        const setActivePanel = (panelId) => {
          shell.classList.add('has-active-panel');

          categoryItems.forEach((item) => {
            item.classList.toggle('is-active', item.dataset.marvinPanel === panelId);
          });

          panels.forEach((panel) => {
            panel.classList.toggle('is-active', panel.dataset.marvinPanel === panelId);
          });
        };

        const resetPanels = () => {
          shell.classList.remove('has-active-panel');

          categoryItems.forEach((item) => {
            item.classList.remove('is-active');
          });

          panels.forEach((panel) => {
            panel.classList.remove('is-active');
          });
        };

        shell.addEventListener('pointerover', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const trigger = target.closest('[data-marvin-panel]');
          if (!trigger || !shell.contains(trigger)) return;

          const panelId = trigger.getAttribute('data-marvin-panel');
          if (!panelId) return;

          setActivePanel(panelId);
        });

        shell.addEventListener('focusin', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const trigger = target.closest('[data-marvin-panel]');
          if (!trigger || !shell.contains(trigger)) return;

          const panelId = trigger.getAttribute('data-marvin-panel');
          if (!panelId) return;

          setActivePanel(panelId);
        });

        shell.addEventListener('mouseleave', resetPanels);
        shell.addEventListener('focusout', (event) => {
          if (!shell.contains(event.relatedTarget)) {
            resetPanels();
          }
        });
      });
    })();
  </script>
{% endif %}

{% case menu_content_type %}
  {% when 'featured_products' %}
    {%- capture image_sizes -%}
      {%- render 'util-mega-menu-img-sizes-attr', menu_content_type: 'featured_products', settings: settings, grid_columns: grid_columns_count, grid_columns_tablet: grid_columns_count_tablet -%}
    {%- endcapture -%}

    <span class="mega-menu__content"
          style="--menu-content-columns-desktop: {{ max_product_columns }}; --menu-content-columns-tablet: {{ max_product_columns_tablet }}; --resource-card-corner-radius: {{ image_border_radius }}px;">
      <ul class="mega-menu__content-list mega-menu__content-list--products list-unstyled">
        {% if eager_loading %}
          {% paginate collection_object.products by max_featured_products %}
            {% for item in collection_object.products %}
              <li class="mega-menu__content-list-item {% if forloop.index > max_featured_products_tablet %} mega-menu__content-list-item--hidden-tablet{% endif %}">
                {% render 'resource-card', resource: item, resource_type: 'product', image_hover: true, image_aspect_ratio: '5 / 3', image_sizes: image_sizes, featured_image_override: item.metafields.custom.menu_image.value, show_menu_small_text: true %}
              </li>
            {% endfor %}
          {% endpaginate %}
        {% endif %}
      </ul>
    </span>
  {% when 'featured_collections' %}
    {% assign collection_handles = collection_handles | split: ',' | uniq %}
    {%- capture image_sizes -%}
      {%- render 'util-mega-menu-img-sizes-attr', menu_content_type: 'featured_collections', settings: settings -%}
    {%- endcapture -%}

    {% if collection_handles.size == 1 %}
      {% assign max_featured_collections = 1 %}
    {% endif %}

    <span class="mega-menu__content"
          style="--menu-content-columns-desktop: {{ max_collection_columns }}; --menu-content-columns-tablet: {{ max_collection_columns_tablet }}; --resource-card-corner-radius: {{ image_border_radius }}px;">
      <ul class="mega-menu__content-list mega-menu__content-list--collections list-unstyled"
          style="--menu-content-columns-desktop: {{ max_featured_collections }}; --menu-content-columns-tablet: {{ max_featured_collections_tablet }};">
        {% for handle in collection_handles limit: max_featured_collections %}
          {% if handle == 'all' %}
            {% assign collection_object = collections.all %}
          {% else %}
            {% assign collection_object = collections[handle] %}
          {% endif %}
          <li class="mega-menu__content-list-item{% if forloop.index > max_featured_collections_tablet %} mega-menu__content-list-item--hidden-tablet{% endif %}">
            {% render 'resource-card', resource: collection_object, resource_type: 'collection', style: 'overlay', image_aspect_ratio: content_aspect_ratio, image_sizes: image_sizes, featured_image_override: collection_object.metafields.custom.menu_image.value %}
          </li>
        {% endfor %}
      </ul>
    </span>
{% endcase %}
